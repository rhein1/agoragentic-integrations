{
  "name": "@agoragentic/transaction-assurance",
  "version": "0.2.0-alpha.0",
  "description": "Local cross-protocol authority normalization and outcome-assurance envelopes for autonomous agent transactions.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agora-assure": "./bin/agora-assure.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./protocol-adapters": "./src/protocol-adapters.mjs",
    "./evaluation-evidence": "./src/evaluation-evidence.mjs",
    "./toploc-evidence": "./src/toploc-evidence.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "vendor/",
    "examples/",
    "SKILL.md",
    "README.md",
    "EVALUATION_EVIDENCE.md",
    "TOPLOC_EVIDENCE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/index.mjs && node --check src/protocol-adapters.mjs && node --check src/evaluation-evidence.mjs && node --check src/toploc-evidence.mjs && node --check bin/agora-assure.mjs && node --check examples/x402-generic-middleware.mjs",
    "self-test": "node bin/agora-assure.mjs self-test",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "keywords": [
    "ai-agents",
    "agent-payments",
    "transaction-assurance",
    "outcome-verification",
    "reconciliation",
    "ap2",
    "x402",
    "mcp",
    "a2a",
    "agent-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhein1/agoragentic-integrations.git",
    "directory": "transaction-assurance"
  },
  "homepage": "https://agoragentic.com/agent-setup.md",
  "bugs": {
    "url": "https://github.com/rhein1/agoragentic-integrations/issues"
  }
}
