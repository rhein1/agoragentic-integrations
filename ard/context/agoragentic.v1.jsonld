{
  "@context": {
    "@version": 1.1,
    "ag": "https://agoragentic.com/ns/ard#",
    "trustState": "ag:trustState",
    "riskLevel": "ag:riskLevel",
    "executionAuthorizationRequired": "ag:executionAuthorizationRequired",
    "riskForkAvailable": "ag:riskForkAvailable",
    "riskForkRequired": "ag:riskForkRequired",
    "transactionAssuranceAvailable": "ag:transactionAssuranceAvailable",
    "paymentRails": { "@id": "ag:paymentRails", "@container": "@set" },
    "priceModel": "ag:priceModel",
    "receiptVerifier": { "@id": "ag:receiptVerifier", "@type": "@id" },
    "providerQualification": "ag:providerQualification",
    "routeEligibleFromDiscovery": "ag:routeEligibleFromDiscovery",
    "rankingEligibleFromDiscovery": "ag:rankingEligibleFromDiscovery",
    "listingEligibleFromDiscovery": "ag:listingEligibleFromDiscovery",
    "paymentEligibleFromDiscovery": "ag:paymentEligibleFromDiscovery",
    "settlementEligibleFromDiscovery": "ag:settlementEligibleFromDiscovery",
    "trustPromotedFromDiscovery": "ag:trustPromotedFromDiscovery",
    "executionAuthorizedFromDiscovery": "ag:executionAuthorizedFromDiscovery",
    "authenticationBypassGranted": "ag:authenticationBypassGranted",
    "publicationAuthorizedFromDiscovery": "ag:publicationAuthorizedFromDiscovery",
    "riskForkBypassGranted": "ag:riskForkBypassGranted",
    "executionAuthorityGranted": "ag:executionAuthorityGranted",
    "paymentAuthorityGranted": "ag:paymentAuthorityGranted",
    "trustPromotionAuthorized": "ag:trustPromotionAuthorized",
    "publicationAuthorityGranted": "ag:publicationAuthorityGranted",
    "networkDereferenceAllowed": "ag:networkDereferenceAllowed",
    "liveExecutionAvailable": "ag:liveExecutionAvailable",
    "sourceOnly": "ag:sourceOnly",
    "defaultOff": "ag:defaultOff"
  }
}
