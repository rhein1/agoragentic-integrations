-- Database-owner bootstrap for the Risk Fork managed worker-delivery store.
-- Dedicated local disposable database only; do not apply to a shared database.
-- Replace every placeholder with a separately provisioned, validated lowercase
-- PostgreSQL identifier. Roles must already be NOINHERIT LOGIN roles created by
-- the managed secret workflow. This file contains no passwords or secrets.
--
-- Run as the owner of __RISK_FORK_MANAGED_DATABASE__ before migration 002,
-- then run migrations as __RISK_FORK_MANAGED_MIGRATOR_ROLE__. The schema and
-- all migration-created objects must remain owned by the distinct migrator.

BEGIN;

REVOKE CONNECT, CREATE, TEMPORARY
  ON DATABASE __RISK_FORK_MANAGED_DATABASE__ FROM PUBLIC;
GRANT CONNECT, CREATE
  ON DATABASE __RISK_FORK_MANAGED_DATABASE__
  TO __RISK_FORK_MANAGED_MIGRATOR_ROLE__;
GRANT CONNECT
  ON DATABASE __RISK_FORK_MANAGED_DATABASE__
  TO __RISK_FORK_MANAGED_RUNTIME_ROLE__;
REVOKE CREATE, TEMPORARY
  ON DATABASE __RISK_FORK_MANAGED_DATABASE__
  FROM __RISK_FORK_MANAGED_RUNTIME_ROLE__;

CREATE SCHEMA IF NOT EXISTS __RISK_FORK_MANAGED_SCHEMA__;
ALTER SCHEMA __RISK_FORK_MANAGED_SCHEMA__
  OWNER TO __RISK_FORK_MANAGED_MIGRATOR_ROLE__;
REVOKE ALL ON SCHEMA __RISK_FORK_MANAGED_SCHEMA__ FROM PUBLIC;
GRANT USAGE, CREATE ON SCHEMA __RISK_FORK_MANAGED_SCHEMA__
  TO __RISK_FORK_MANAGED_MIGRATOR_ROLE__;
GRANT USAGE ON SCHEMA __RISK_FORK_MANAGED_SCHEMA__
  TO __RISK_FORK_MANAGED_RUNTIME_ROLE__;
REVOKE CREATE ON SCHEMA __RISK_FORK_MANAGED_SCHEMA__
  FROM __RISK_FORK_MANAGED_RUNTIME_ROLE__;

COMMIT;
