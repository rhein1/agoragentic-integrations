      }
    ],
    "functions": [
      {
        "name": "guard_request_policy_control",
        "prosecdef": false,
        "proconfig": [
          "search_path=pg_catalog"
        ],
        "provolatile": "v",
        "proparallel": "u",
        "proleakproof": false,
        "proisstrict": false,
        "prokind": "f",
        "proretset": false,
        "language": "plpgsql",
        "args": "",
        "definition": "CREATE OR REPLACE FUNCTION __schema__.guard_request_policy_control()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$\nBEGIN\n  IF NEW.singleton IS DISTINCT FROM OLD.singleton\n     OR NEW.policy_hash IS DISTINCT FROM OLD.policy_hash\n     OR NEW.epoch <> OLD.epoch + 1 THEN\n    RAISE EXCEPTION 'request policy control update must advance the epoch exactly once';\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n"
      }
