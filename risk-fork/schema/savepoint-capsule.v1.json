{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agoragentic.com/schema/risk-fork-savepoint-capsule.v1.json",
  "title": "Agoragentic Risk Fork Savepoint Capsule V1",
  "description": "A bounded, reference-and-hash-only parent-state capsule. It contains no raw prompts, memory, workspace content, credentials, wallet material, execution authority, or process-memory runtime snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capsule_id", "created_at", "expires_at", "parent", "agent_configuration", "checkpoint", "memory_roots", "workspace", "governance", "receipt_chain_head", "proposed_interaction", "execution_authorization", "authorized_result_schema_hash", "allowed_commit_types", "runtime_snapshot", "content_boundaries", "capsule_hash"],
  "properties": {
    "schema": { "const": "agoragentic.risk-fork.savepoint-capsule.v1" },
    "capsule_id": { "$ref": "#/$defs/ref200" },
    "created_at": { "$ref": "#/$defs/date" },
    "expires_at": { "$ref": "#/$defs/date" },
    "parent": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "session_id", "state_hash", "lineage_ref", "lineage_hash"],
      "properties": {
        "agent_id": { "$ref": "#/$defs/ref" }, "session_id": { "$ref": "#/$defs/ref" },
        "state_hash": { "$ref": "#/$defs/sha256" }, "lineage_ref": { "$ref": "#/$defs/nullableRef" },
        "lineage_hash": { "$ref": "#/$defs/nullableSha256" }
      },
      "oneOf": [
        { "properties": { "lineage_ref": { "type": "null" }, "lineage_hash": { "type": "null" } }, "required": ["lineage_ref", "lineage_hash"] },
        { "properties": { "lineage_ref": { "$ref": "#/$defs/ref" }, "lineage_hash": { "$ref": "#/$defs/sha256" } }, "required": ["lineage_ref", "lineage_hash"] }
      ]
    },
    "agent_configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["model_version_hash", "system_instruction_hash", "tool_manifest_hash"],
      "properties": {
        "model_version_hash": { "$ref": "#/$defs/sha256" }, "system_instruction_hash": { "$ref": "#/$defs/sha256" },
        "tool_manifest_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["goal_ref", "goal_hash", "task_graph_ref", "task_graph_hash"],
      "properties": {
        "goal_ref": { "$ref": "#/$defs/ref" }, "goal_hash": { "$ref": "#/$defs/sha256" },
        "task_graph_ref": { "$ref": "#/$defs/ref" }, "task_graph_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "memory_roots": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref", "digest", "kind", "truncation_possible"],
        "properties": {
          "ref": { "$ref": "#/$defs/ref" }, "digest": { "$ref": "#/$defs/sha256" },
          "kind": { "$ref": "#/$defs/nullableRef100" }, "truncation_possible": { "type": "boolean" }
        }
      }
    },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_ref", "digest"],
      "properties": { "snapshot_ref": { "$ref": "#/$defs/ref" }, "digest": { "$ref": "#/$defs/sha256" } }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_ref", "policy_version", "policy_hash", "mandate_ref", "mandate_version", "mandate_hash", "budget_policy_ref", "budget_version", "budget_hash", "epoch"],
      "properties": {
        "policy_ref": { "$ref": "#/$defs/ref" }, "policy_version": { "$ref": "#/$defs/ref" }, "policy_hash": { "$ref": "#/$defs/sha256" },
        "mandate_ref": { "$ref": "#/$defs/nullableRef" }, "mandate_version": { "$ref": "#/$defs/nullableRef" }, "mandate_hash": { "$ref": "#/$defs/nullableSha256" },
        "budget_policy_ref": { "$ref": "#/$defs/nullableRef" }, "budget_version": { "$ref": "#/$defs/nullableRef" }, "budget_hash": { "$ref": "#/$defs/nullableSha256" },
        "epoch": { "$ref": "#/$defs/ref" }
      },
      "allOf": [
        {
          "oneOf": [
            { "properties": { "mandate_ref": { "type": "null" }, "mandate_version": { "type": "null" }, "mandate_hash": { "type": "null" } }, "required": ["mandate_ref", "mandate_version", "mandate_hash"] },
            { "properties": { "mandate_ref": { "$ref": "#/$defs/ref" }, "mandate_version": { "$ref": "#/$defs/ref" }, "mandate_hash": { "$ref": "#/$defs/sha256" } }, "required": ["mandate_ref", "mandate_version", "mandate_hash"] }
          ]
        },
        {
          "oneOf": [
            { "properties": { "budget_policy_ref": { "type": "null" }, "budget_version": { "type": "null" }, "budget_hash": { "type": "null" } }, "required": ["budget_policy_ref", "budget_version", "budget_hash"] },
            { "properties": { "budget_policy_ref": { "$ref": "#/$defs/ref" }, "budget_version": { "$ref": "#/$defs/ref" }, "budget_hash": { "$ref": "#/$defs/sha256" } }, "required": ["budget_policy_ref", "budget_version", "budget_hash"] }
          ]
        }
      ]
    },
    "receipt_chain_head": { "$ref": "#/$defs/sha256" },
    "proposed_interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["mcp_server_ref", "mcp_server_origin", "mcp_method", "raw_method", "tool_name", "effective_arguments_hash", "target_ref"],
      "properties": {
        "mcp_server_ref": { "$ref": "#/$defs/ref" }, "mcp_server_origin": { "$ref": "#/$defs/httpEndpoint" },
        "mcp_method": { "$ref": "#/$defs/mcpPhase" }, "raw_method": { "$ref": "#/$defs/nullableMcpRawMethod" },
        "tool_name": { "$ref": "#/$defs/nullableRef" },
        "effective_arguments_hash": { "$ref": "#/$defs/sha256" }, "target_ref": { "$ref": "#/$defs/nullableRef" }
      },
      "allOf": [{
        "if": { "properties": { "mcp_method": { "const": "UNKNOWN" } }, "required": ["mcp_method"] },
        "then": { "properties": { "raw_method": { "$ref": "#/$defs/mcpRawMethod" } } },
        "else": { "properties": { "raw_method": { "type": "null" } } }
      }]
    },
    "execution_authorization": {
      "type": "object", "additionalProperties": false, "required": ["ref", "hash"],
      "properties": { "ref": { "$ref": "#/$defs/nullableRef" }, "hash": { "$ref": "#/$defs/nullableSha256" } },
      "oneOf": [
        { "properties": { "ref": { "type": "null" }, "hash": { "type": "null" } }, "required": ["ref", "hash"] },
        { "properties": { "ref": { "$ref": "#/$defs/ref" }, "hash": { "$ref": "#/$defs/sha256" } }, "required": ["ref", "hash"] }
      ]
    },
    "authorized_result_schema_hash": { "$ref": "#/$defs/sha256" },
    "allowed_commit_types": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": { "enum": ["TYPED_RESULT", "WORKSPACE_DIFF", "CONSEQUENTIAL_ACTION_PROPOSAL"] }
    },
    "runtime_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "provider_ref", "snapshot_ref", "snapshot_hash", "sanitization_attestation_ref", "sanitization_attestation_hash", "verification_status"],
      "properties": {
        "mode": { "enum": ["none", "filesystem"] },
        "provider_ref": { "$ref": "#/$defs/nullableRef" }, "snapshot_ref": { "$ref": "#/$defs/nullableRef" },
        "snapshot_hash": { "$ref": "#/$defs/nullableSha256" }, "sanitization_attestation_ref": { "$ref": "#/$defs/nullableRef" },
        "sanitization_attestation_hash": { "$ref": "#/$defs/nullableSha256" },
        "verification_status": { "enum": ["not_checked", "verified", "failed", "unknown"] }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] }, "then": { "properties": { "provider_ref": { "type": "null" }, "snapshot_ref": { "type": "null" }, "snapshot_hash": { "type": "null" }, "sanitization_attestation_ref": { "type": "null" }, "sanitization_attestation_hash": { "type": "null" }, "verification_status": { "const": "not_checked" } } } },
        { "if": { "properties": { "mode": { "const": "filesystem" } }, "required": ["mode"] }, "then": { "properties": { "provider_ref": { "$ref": "#/$defs/ref" }, "snapshot_ref": { "$ref": "#/$defs/ref" }, "snapshot_hash": { "$ref": "#/$defs/sha256" }, "sanitization_attestation_ref": { "$ref": "#/$defs/ref" }, "sanitization_attestation_hash": { "$ref": "#/$defs/sha256" }, "verification_status": { "const": "verified" } } } }
      ]
    },
    "content_boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_prompt_included", "raw_conversation_included", "raw_memory_included", "workspace_content_included", "credentials_included", "wallet_material_included", "execution_authority_included"],
      "properties": {
        "raw_prompt_included": { "const": false }, "raw_conversation_included": { "const": false },
        "raw_memory_included": { "const": false }, "workspace_content_included": { "const": false },
        "credentials_included": { "const": false }, "wallet_material_included": { "const": false },
        "execution_authority_included": { "const": false }
      }
    },
    "capsule_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "ref": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/~])(?![Ff][Ii][Ll][Ee]:)(?!.*\\s).+$", "allOf": [{ "not": { "type": "string", "pattern": "\\b(?:sk|amk|ghp|github_pat|xox[baprs])-[_a-zA-Z0-9-]{12,}\\b" } }, { "not": { "type": "string", "pattern": "\\bAKIA[A-Z0-9]{16}\\b" } }, { "not": { "type": "string", "pattern": "(?:[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Tt][Oo][Kk][Ee][Nn]|[Rr][Ee][Ff][Rr][Ee][Ss][Hh][_-]?[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]|[Mm][Nn][Ee][Mm][Oo][Nn][Ii][Cc])\\s*[=:]\\s*[^&\\s]{8,}" } }] },
    "ref200": { "allOf": [{ "$ref": "#/$defs/ref" }, { "type": "string", "maxLength": 200 }] },
    "mcpRawMethod": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "nullableRef": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "nullableMcpRawMethod": { "oneOf": [{ "$ref": "#/$defs/mcpRawMethod" }, { "type": "null" }] },
    "ref100": { "allOf": [{ "$ref": "#/$defs/ref" }, { "type": "string", "maxLength": 100 }] },
    "nullableRef100": { "oneOf": [{ "$ref": "#/$defs/ref100" }, { "type": "null" }] },
    "date": { "type": "string", "format": "date-time", "maxLength": 64 },
    "httpEndpoint": { "type": "string", "format": "uri", "pattern": "^https?://(?![^/?#]*@)[^?#]+$", "maxLength": 4096 },
    "mcpPhase": { "enum": ["server/discover", "initialize", "tools/list", "resources/list", "resources/read", "prompts/list", "prompts/get", "tools/call", "UNKNOWN"] }
  }
}
