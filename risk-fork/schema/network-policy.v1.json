{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agoragentic.com/schema/risk-fork-network-policy.v1.json",
  "title": "Agoragentic Risk Fork Network Policy V1",
  "description": "A hash-bound blocked or explicit-allowlist egress policy. A provider must separately prove enforcement.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "mode", "allowlist", "policy_hash"],
  "properties": {
    "schema": { "const": "agoragentic.risk-fork.network-policy.v1" }, "mode": { "enum": ["blocked", "allowlist"] },
    "allowlist": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/httpEndpoint" } },
    "policy_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "oneOf": [
    { "properties": { "mode": { "const": "blocked" }, "allowlist": { "type": "array", "maxItems": 0 } }, "required": ["mode", "allowlist"] },
    { "properties": { "mode": { "const": "allowlist" }, "allowlist": { "type": "array", "minItems": 1 } }, "required": ["mode", "allowlist"] }
  ],
  "$defs": {
    "httpEndpoint": {
      "type": "string", "format": "uri", "minLength": 1, "maxLength": 500,
      "pattern": "^https?://(?![^/?#]*@)[^?#]+$"
    }
  }
}
