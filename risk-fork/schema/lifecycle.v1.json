{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agoragentic.com/schema/risk-fork-lifecycle.v1.json",
  "title": "Agoragentic Risk Fork Lifecycle V1",
  "description": "An append-only, hash-linked lifecycle controlled only by the clean controller. Transition legality and hashes require source-level verification.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "run_id", "version", "state", "fork_resource_state", "events", "chain_head"],
  "properties": {
    "schema": { "const": "agoragentic.risk-fork.lifecycle.v1" },
    "run_id": { "$ref": "#/$defs/ref200" }, "version": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "state": { "$ref": "#/$defs/runState" }, "fork_resource_state": { "$ref": "#/$defs/resourceState" },
    "events": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/event" } },
    "chain_head": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ref": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/~])(?![Ff][Ii][Ll][Ee]:)(?!.*\\s).+$", "allOf": [{ "not": { "type": "string", "pattern": "\\b(?:sk|amk|ghp|github_pat|xox[baprs])-[_a-zA-Z0-9-]{12,}\\b" } }, { "not": { "type": "string", "pattern": "\\bAKIA[A-Z0-9]{16}\\b" } }, { "not": { "type": "string", "pattern": "(?:[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Tt][Oo][Kk][Ee][Nn]|[Rr][Ee][Ff][Rr][Ee][Ss][Hh][_-]?[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]|[Mm][Nn][Ee][Mm][Oo][Nn][Ii][Cc])\\s*[=:]\\s*[^&\\s]{8,}" } }] },
    "ref200": { "allOf": [{ "$ref": "#/$defs/ref" }, { "type": "string", "maxLength": 200 }] },
    "date": { "type": "string", "format": "date-time", "maxLength": 64 },
    "runState": { "enum": ["REQUESTED", "SAVEPOINTING", "SAVEPOINT_READY", "SAVEPOINT_FAILED", "FORK_STARTING", "FORK_READY", "FORK_FAILED", "EXECUTING", "TAINTED", "EXECUTION_FAILED", "VALIDATING", "COMMIT_READY", "VALIDATION_FAILED", "PRECOMMIT_DESTROYING", "CLEAN_COMMIT_READY", "COMMITTING", "COMMITTED", "COMMIT_FAILED", "COMMIT_AMBIGUOUS", "ABORTING", "ABORTED", "DESTROYING", "DESTROYED", "DESTRUCTION_UNKNOWN", "DESTRUCTION_FAILED"] },
    "resourceState": { "enum": ["NOT_CREATED", "ACTIVE", "SUSPENDED", "DESTROY_REQUESTED", "DESTROYED", "DESTROY_UNKNOWN"] },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["status", "ref", "hash", "detail"],
      "properties": {
        "status": { "enum": ["requested", "observed", "verified", "failed", "unknown", "not_applicable"] },
        "ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "hash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "detail": { "$ref": "#/$defs/nullableRef500" }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "at", "actor", "from", "to", "reason", "evidence", "fork_resource_state", "previous_event_hash", "event_hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "at": { "$ref": "#/$defs/date" },
        "actor": { "const": "clean_controller" }, "from": { "oneOf": [{ "$ref": "#/$defs/runState" }, { "type": "null" }] },
        "to": { "$ref": "#/$defs/runState" }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence": { "$ref": "#/$defs/evidence" }, "fork_resource_state": { "$ref": "#/$defs/resourceState" },
        "previous_event_hash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "event_hash": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        { "if": { "properties": { "to": { "enum": ["CLEAN_COMMIT_READY", "DESTROYED"] } }, "required": ["to"] }, "then": { "properties": { "fork_resource_state": { "const": "DESTROYED" }, "evidence": { "type": "object", "properties": { "status": { "const": "verified" }, "ref": { "$ref": "#/$defs/ref" }, "hash": { "$ref": "#/$defs/sha256" } }, "required": ["status", "ref", "hash"] } } } },
        { "if": { "properties": { "to": { "const": "DESTRUCTION_UNKNOWN" } }, "required": ["to"] }, "then": { "properties": { "evidence": { "type": "object", "properties": { "status": { "const": "unknown" } }, "required": ["status"] } } } },
        { "if": { "properties": { "to": { "const": "DESTRUCTION_FAILED" } }, "required": ["to"] }, "then": { "properties": { "evidence": { "type": "object", "properties": { "status": { "const": "failed" } }, "required": ["status"] } } } }
      ]
    },
    "ref500": { "allOf": [{ "$ref": "#/$defs/ref" }, { "type": "string", "maxLength": 500 }] },
    "nullableRef500": { "oneOf": [{ "$ref": "#/$defs/ref500" }, { "type": "null" }] }
  }
}
