{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agoragentic.com/schema/risk-fork-commit-artifact.v1.json",
  "title": "Agoragentic Risk Fork Commit Artifact V1",
  "description": "A tainted-source artifact admitted through the clean taint gate. Only typed results, bounded workspace diffs, and exact consequential-action proposals are supported; memory merge is forbidden.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "commit_type", "source_fork_id", "taint_status", "validated_at", "body", "validation", "artifact_hash", "authority_flags"],
  "properties": {
    "schema": { "const": "agoragentic.risk-fork.commit-artifact.v1" },
    "commit_type": { "$ref": "#/$defs/commitType" }, "source_fork_id": { "$ref": "#/$defs/ref" },
    "taint_status": { "const": "TAINTED_SOURCE_VALIDATED" }, "validated_at": { "$ref": "#/$defs/date" },
    "body": {}, "validation": { "$ref": "#/$defs/validation" }, "artifact_hash": { "$ref": "#/$defs/sha256" },
    "authority_flags": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_grants_authority", "child_can_commit", "clean_commit_required"],
      "properties": { "artifact_grants_authority": { "const": false }, "child_can_commit": { "const": false }, "clean_commit_required": { "const": true } }
    }
  },
  "oneOf": [
    { "properties": { "commit_type": { "const": "TYPED_RESULT" }, "body": { "$ref": "#/$defs/typedBody" } }, "required": ["commit_type", "body"] },
    { "properties": { "commit_type": { "const": "WORKSPACE_DIFF" }, "body": { "$ref": "#/$defs/diffBody" } }, "required": ["commit_type", "body"] },
    { "properties": { "commit_type": { "const": "CONSEQUENTIAL_ACTION_PROPOSAL" }, "body": { "$ref": "#/$defs/actionBody" } }, "required": ["commit_type", "body"] }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "ref": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/~])(?![Ff][Ii][Ll][Ee]:)(?!.*\\s).+$", "allOf": [{ "not": { "type": "string", "pattern": "\\b(?:sk|amk|ghp|github_pat|xox[baprs])-[_a-zA-Z0-9-]{12,}\\b" } }, { "not": { "type": "string", "pattern": "\\bAKIA[A-Z0-9]{16}\\b" } }, { "not": { "type": "string", "pattern": "(?:[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Tt][Oo][Kk][Ee][Nn]|[Rr][Ee][Ff][Rr][Ee][Ss][Hh][_-]?[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]|[Mm][Nn][Ee][Mm][Oo][Nn][Ii][Cc])\\s*[=:]\\s*[^&\\s]{8,}" } }] },
    "nullableRef": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "date": { "type": "string", "format": "date-time", "maxLength": 64 },
    "commitType": { "enum": ["TYPED_RESULT", "WORKSPACE_DIFF", "CONSEQUENTIAL_ACTION_PROPOSAL"] },
    "jsonValue": {
      "oneOf": [
        { "type": "null" }, { "type": "boolean" }, { "type": "string", "maxLength": 4194304 },
        { "type": "number" }, { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "propertyNames": { "maxLength": 1024 }, "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_valid", "secret_scan", "prompt_injection_scan", "path_scan", "tests"],
      "properties": {
        "schema_valid": { "const": true }, "secret_scan": { "const": "passed" }, "prompt_injection_scan": { "const": "passed" },
        "path_scan": { "enum": ["passed", "not_applicable"] },
        "tests": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } }
      }
    },
    "typedBody": {
      "type": "object", "additionalProperties": false,
      "required": ["payload", "payload_hash", "payload_schema", "payload_schema_hash", "payload_bytes"],
      "properties": {
        "payload": { "$ref": "#/$defs/jsonValue" }, "payload_hash": { "$ref": "#/$defs/sha256" },
        "payload_schema": { "type": "object" }, "payload_schema_hash": { "$ref": "#/$defs/sha256" },
        "payload_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 }
      }
    },
    "diffFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "operation", "before_hash", "after_hash", "after_content", "after_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$" },
        "operation": { "enum": ["create", "modify", "delete"] }, "before_hash": { "$ref": "#/$defs/nullableSha256" },
        "after_hash": { "$ref": "#/$defs/nullableSha256" }, "after_content": { "type": ["string", "null"], "maxLength": 16777216 },
        "after_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 }
      },
      "allOf": [
        { "if": { "properties": { "operation": { "const": "create" } }, "required": ["operation"] }, "then": { "properties": { "before_hash": { "type": "null" }, "after_hash": { "$ref": "#/$defs/sha256" }, "after_content": { "type": "string" } } } },
        { "if": { "properties": { "operation": { "const": "modify" } }, "required": ["operation"] }, "then": { "properties": { "before_hash": { "$ref": "#/$defs/sha256" }, "after_hash": { "$ref": "#/$defs/sha256" }, "after_content": { "type": "string" } } } },
        { "if": { "properties": { "operation": { "const": "delete" } }, "required": ["operation"] }, "then": { "properties": { "before_hash": { "$ref": "#/$defs/sha256" }, "after_hash": { "type": "null" }, "after_content": { "type": "null" }, "after_bytes": { "const": 0 } } } }
      ]
    },
    "testEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "evidence_ref", "evidence_hash", "duration_ms"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "status": { "enum": ["passed", "failed"] },
        "evidence_ref": { "$ref": "#/$defs/ref" }, "evidence_hash": { "$ref": "#/$defs/sha256" },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 }
      }
    },
    "diffBody": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "file_count", "total_after_bytes", "diff_hash", "test_evidence"],
      "properties": {
        "files": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/diffFile" } },
        "file_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "total_after_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "diff_hash": { "$ref": "#/$defs/sha256" },
        "test_evidence": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/testEvidence" } }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "target_ref", "provider_ref", "arguments", "amount", "currency", "payment_rail"],
      "properties": {
        "operation": { "enum": ["mcp_tool_call", "payment", "send", "publish", "deploy", "database_mutation", "trust_mutation", "git_push"] },
        "target_ref": { "$ref": "#/$defs/nullableRef" }, "provider_ref": { "$ref": "#/$defs/ref" },
        "arguments": { "type": "object", "propertyNames": { "maxLength": 1024 }, "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "amount": { "type": ["string", "null"], "maxLength": 100 }, "currency": { "type": ["string", "null"], "maxLength": 30 },
        "payment_rail": { "$ref": "#/$defs/nullableRef" }
      }
    },
    "actionBody": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "action_hash", "effective_arguments_hash", "execution_binding", "execution_binding_hash"],
      "properties": {
        "action": { "$ref": "#/$defs/action" }, "action_hash": { "$ref": "#/$defs/sha256" },
        "effective_arguments_hash": { "$ref": "#/$defs/sha256" },
        "execution_binding": { "$ref": "https://agoragentic.com/schema/risk-fork-execution-binding.v1.json" },
        "execution_binding_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
