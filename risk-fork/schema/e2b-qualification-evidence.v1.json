{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agoragentic.com/schema/risk-fork-e2b-qualification-evidence.v1.json",
  "title": "Agoragentic Risk Fork E2B Qualification Evidence V1",
  "description": "Closed, sanitized evidence for a single explicitly authorized E2B containment qualification. This record does not grant deployment, spend, or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "provider", "sdk", "template", "runtime", "run", "limits", "observations", "controls", "cleanup", "evidence_refs", "external_observation_receipt", "authority_flags", "evidence_hash"],
  "properties": {
    "schema": { "const": "agoragentic.risk-fork.e2b-qualification-evidence.v1" },
    "status": { "$ref": "#/$defs/status" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "project_ref_hash", "region"],
      "properties": {
        "name": { "const": "e2b" },
        "project_ref_hash": { "$ref": "#/$defs/hash" },
        "region": { "$ref": "#/$defs/opaque" }
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "integrity_hash"],
      "properties": {
        "package": { "const": "e2b" },
        "version": { "const": "2.39.0" },
        "integrity_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id_hash", "build_id_hash", "template_evidence_hash", "provenance_hash"],
      "properties": {
        "template_id_hash": { "$ref": "#/$defs/hash" },
        "build_id_hash": { "$ref": "#/$defs/hash" },
        "template_evidence_hash": { "$ref": "#/$defs/hash" },
        "provenance_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap_artifact_hash", "runner_artifact_hash", "boot_guard_artifact_hash"],
      "properties": {
        "bootstrap_artifact_hash": { "$ref": "#/$defs/hash" },
        "runner_artifact_hash": { "$ref": "#/$defs/hash" },
        "boot_guard_artifact_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_ref_hash", "run_ref_hash", "started_at", "completed_at", "sandbox_count", "synthetic_workspace"],
      "properties": {
        "approval_ref_hash": { "$ref": "#/$defs/hash" },
        "run_ref_hash": { "$ref": "#/$defs/hash" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "sandbox_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "synthetic_workspace": { "type": "boolean" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_ttl_ms", "idle_ttl_ms", "max_execution_ms", "max_cost_usd"],
      "properties": {
        "hard_ttl_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "idle_ttl_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "max_execution_ms": { "type": "integer", "minimum": 100, "maximum": 600000 },
        "max_cost_usd": { "$ref": "#/$defs/decimal" }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fork_start_ms", "execution_ms", "cleanup_ms", "observed_cost_usd"],
      "dependentRequired": {
        "failure_stage": ["failure_class"],
        "failure_class": ["failure_stage"]
      },
      "properties": {
        "fork_start_ms": { "$ref": "#/$defs/duration" },
        "execution_ms": { "$ref": "#/$defs/duration" },
        "cleanup_ms": { "$ref": "#/$defs/duration" },
        "observed_cost_usd": {
          "oneOf": [
            { "$ref": "#/$defs/decimal" },
            { "type": "null" }
          ]
        },
        "failure_stage": { "$ref": "#/$defs/failureStage" },
        "failure_class": { "$ref": "#/$defs/failureClass" }
      },
      "allOf": [
        {
          "if": {
            "required": ["failure_stage"],
            "properties": { "failure_stage": { "const": "none" } }
          },
          "then": { "properties": { "failure_class": { "const": "none" } } }
        },
        {
          "if": {
            "required": ["failure_class"],
            "properties": { "failure_class": { "const": "none" } }
          },
          "then": { "properties": { "failure_stage": { "const": "none" } } }
        }
      ]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_instruction_ipv4_egress_denied", "first_instruction_ipv6_egress_denied", "inherited_environment_absent", "inherited_processes_absent", "credential_files_absent", "wallet_material_absent", "persistent_mounts_absent", "unauthorized_sockets_absent", "fresh_entropy_verified", "template_provenance_verified", "bootstrap_binding_verified", "runner_binding_verified", "hard_ttl_verified", "idle_ttl_verified", "max_execution_time_verified", "destruction_semantics_verified", "orphan_reconciliation_verified", "latency_observed", "cost_within_cap"],
      "properties": {
        "first_instruction_ipv4_egress_denied": { "$ref": "#/$defs/control" },
        "first_instruction_ipv6_egress_denied": { "$ref": "#/$defs/control" },
        "inherited_environment_absent": { "$ref": "#/$defs/control" },
        "inherited_processes_absent": { "$ref": "#/$defs/control" },
        "credential_files_absent": { "$ref": "#/$defs/control" },
        "wallet_material_absent": { "$ref": "#/$defs/control" },
        "persistent_mounts_absent": { "$ref": "#/$defs/control" },
        "unauthorized_sockets_absent": { "$ref": "#/$defs/control" },
        "fresh_entropy_verified": { "$ref": "#/$defs/control" },
        "template_provenance_verified": { "$ref": "#/$defs/control" },
        "bootstrap_binding_verified": { "$ref": "#/$defs/control" },
        "runner_binding_verified": { "$ref": "#/$defs/control" },
        "hard_ttl_verified": { "$ref": "#/$defs/control" },
        "idle_ttl_verified": { "$ref": "#/$defs/control" },
        "max_execution_time_verified": { "$ref": "#/$defs/control" },
        "destruction_semantics_verified": { "$ref": "#/$defs/control" },
        "orphan_reconciliation_verified": { "$ref": "#/$defs/control" },
        "latency_observed": { "$ref": "#/$defs/control" },
        "cost_within_cap": { "$ref": "#/$defs/control" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kill_requested", "absence_verified", "orphan_reconciliation"],
      "properties": {
        "kill_requested": { "$ref": "#/$defs/control" },
        "absence_verified": { "$ref": "#/$defs/control" },
        "orphan_reconciliation": { "$ref": "#/$defs/control" }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "$comment": "uniqueItems rejects exact duplicate objects only; validateE2BQualificationEvidence additionally requires every ref key to be unique even when hashes differ.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "hash"],
        "properties": {
          "ref": { "$ref": "#/$defs/opaque" },
          "hash": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "external_observation_receipt": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/externalObservationReceipt" }
      ]
    },
    "authority_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentials_included", "wallet_material_included", "execution_authority_included", "production_activation_granted"],
      "properties": {
        "credentials_included": { "const": false },
        "wallet_material_included": { "const": false },
        "execution_authority_included": { "const": false },
        "production_activation_granted": { "const": false }
      }
    },
    "evidence_hash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "verified" } }
      },
      "then": {
        "properties": {
          "observations": {
            "not": {
              "type": "object",
              "required": ["failure_stage"],
              "properties": { "failure_stage": { "not": { "const": "none" } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["external_observation_receipt"],
        "properties": { "external_observation_receipt": { "type": "null" } }
      },
      "then": {
        "properties": {
          "controls": {
            "type": "object",
            "properties": {
              "inherited_environment_absent": { "const": "unknown" },
              "inherited_processes_absent": { "const": "unknown" },
              "credential_files_absent": { "const": "unknown" },
              "wallet_material_absent": { "const": "unknown" },
              "persistent_mounts_absent": { "const": "unknown" },
              "unauthorized_sockets_absent": { "const": "unknown" },
              "fresh_entropy_verified": { "const": "unknown" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "opaque": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$" },
    "duration": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "control": { "enum": ["verified", "failed", "unknown"] },
    "status": { "enum": ["verified", "failed", "unknown"] },
    "failureStage": {
      "enum": ["none", "sandbox_create", "sandbox_handle_validation", "initial_provider_info_fetch", "initial_provider_info_validation", "birth_handshake", "execution_lease_set", "execution_lease_info_fetch", "execution_lease_info_validation", "idle_lease_set", "idle_lease_info_fetch", "idle_lease_info_validation"]
    },
    "failureClass": {
      "enum": ["none", "provider_absence", "provider_timeout", "provider_call_failure", "provider_contract_contradiction", "canary_contract_failure"]
    },
    "nullableHash": {
      "oneOf": [
        { "$ref": "#/$defs/hash" },
        { "type": "null" }
      ]
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "public_key_spki_base64url", "public_key_hash"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "public_key_spki_base64url": {
          "type": "string",
          "minLength": 40,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "public_key_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "observationAudience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "project_ref_hash", "run_ref_hash", "template_id_hash", "template_build_id_hash"],
      "properties": {
        "profile": { "const": "agoragentic.risk-fork.e2b-qualification" },
        "project_ref_hash": { "$ref": "#/$defs/hash" },
        "run_ref_hash": { "$ref": "#/$defs/hash" },
        "template_id_hash": { "$ref": "#/$defs/hash" },
        "template_build_id_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "observationBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_ref_hash", "run_ref_hash", "project_ref_hash", "sdk_integrity_hash", "template_id_hash", "template_build_id_hash", "template_evidence_hash", "template_provenance_hash", "bootstrap_artifact_hash", "runner_artifact_hash", "boot_guard_artifact_hash", "limits_hash", "canary_evidence_hash", "sandbox_id_hash", "metadata_hash", "provider_template_binding_hash", "birth_request_hash", "birth_attestation_hash", "boot_evidence_hash", "sandbox_birth_binding_hash", "ipv4_probe_hash", "ipv6_probe_hash"],
      "properties": {
        "approval_ref_hash": { "$ref": "#/$defs/hash" },
        "run_ref_hash": { "$ref": "#/$defs/hash" },
        "project_ref_hash": { "$ref": "#/$defs/hash" },
        "sdk_integrity_hash": { "$ref": "#/$defs/hash" },
        "template_id_hash": { "$ref": "#/$defs/hash" },
        "template_build_id_hash": { "$ref": "#/$defs/hash" },
        "template_evidence_hash": { "$ref": "#/$defs/hash" },
        "template_provenance_hash": { "$ref": "#/$defs/hash" },
        "bootstrap_artifact_hash": { "$ref": "#/$defs/hash" },
        "runner_artifact_hash": { "$ref": "#/$defs/hash" },
        "boot_guard_artifact_hash": { "$ref": "#/$defs/hash" },
        "limits_hash": { "$ref": "#/$defs/hash" },
        "canary_evidence_hash": { "$ref": "#/$defs/hash" },
        "sandbox_id_hash": { "$ref": "#/$defs/hash" },
        "metadata_hash": { "$ref": "#/$defs/hash" },
        "provider_template_binding_hash": { "$ref": "#/$defs/hash" },
        "birth_request_hash": { "$ref": "#/$defs/hash" },
        "birth_attestation_hash": { "$ref": "#/$defs/hash" },
        "boot_evidence_hash": { "$ref": "#/$defs/hash" },
        "sandbox_birth_binding_hash": { "$ref": "#/$defs/hash" },
        "ipv4_probe_hash": { "$ref": "#/$defs/hash" },
        "ipv6_probe_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "requestedLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_ttl_ms", "idle_ttl_ms", "max_execution_ms", "max_cost_usd"],
      "properties": {
        "hard_ttl_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "idle_ttl_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "max_execution_ms": { "type": "integer", "minimum": 100, "maximum": 600000 },
        "max_cost_usd": { "$ref": "#/$defs/decimal" }
      }
    },
    "statusEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_hash"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "evidence_hash": { "$ref": "#/$defs/nullableHash" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } } },
          "then": { "properties": { "evidence_hash": { "$ref": "#/$defs/hash" } } }
        }
      ]
    },
    "nonVerifiedStatusEvidence": {
      "type": "object",
      "properties": {
        "status": { "enum": ["failed", "unknown"] }
      }
    },
    "observerBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_class", "status", "evidence_hash", "child_write_access", "reusable_signing_authority_in_child"],
      "properties": {
        "producer_class": { "enum": ["provider_control_plane", "privileged_host_supervisor"] },
        "status": { "$ref": "#/$defs/status" },
        "evidence_hash": { "$ref": "#/$defs/nullableHash" },
        "child_write_access": { "const": false },
        "reusable_signing_authority_in_child": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } } },
          "then": { "properties": { "evidence_hash": { "$ref": "#/$defs/hash" } } }
        }
      ]
    },
    "birthControls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherited_environment_absent", "inherited_processes_absent", "credential_files_absent", "wallet_material_absent", "persistent_mounts_absent", "unauthorized_sockets_absent", "fresh_entropy_verified"],
      "properties": {
        "inherited_environment_absent": { "$ref": "#/$defs/statusEvidence" },
        "inherited_processes_absent": { "$ref": "#/$defs/statusEvidence" },
        "credential_files_absent": { "$ref": "#/$defs/statusEvidence" },
        "wallet_material_absent": { "$ref": "#/$defs/statusEvidence" },
        "persistent_mounts_absent": { "$ref": "#/$defs/statusEvidence" },
        "unauthorized_sockets_absent": { "$ref": "#/$defs/statusEvidence" },
        "fresh_entropy_verified": { "$ref": "#/$defs/statusEvidence" }
      }
    },
    "providerControls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_provenance_verified", "bootstrap_binding_verified", "runner_binding_verified", "hard_ttl_verified", "idle_ttl_verified", "max_execution_time_verified"],
      "properties": {
        "template_provenance_verified": { "$ref": "#/$defs/providerControl" },
        "bootstrap_binding_verified": { "$ref": "#/$defs/providerControl" },
        "runner_binding_verified": { "$ref": "#/$defs/providerControl" },
        "hard_ttl_verified": { "$ref": "#/$defs/providerControl" },
        "idle_ttl_verified": { "$ref": "#/$defs/providerControl" },
        "max_execution_time_verified": { "$ref": "#/$defs/providerControl" }
      }
    },
    "providerControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_hash"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "evidence_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "observedCostLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_usd", "evidence_hash"],
      "properties": {
        "amount_usd": { "$ref": "#/$defs/decimal" },
        "evidence_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "actualSandboxCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "amount_usd", "evidence_hash"],
      "properties": {
        "status": { "enum": ["finalized", "unknown"] },
        "amount_usd": {
          "oneOf": [
            { "$ref": "#/$defs/decimal" },
            { "type": "null" }
          ]
        },
        "evidence_hash": { "$ref": "#/$defs/nullableHash" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unknown" } } },
          "then": {
            "properties": {
              "amount_usd": { "type": "null" },
              "evidence_hash": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "amount_usd": { "$ref": "#/$defs/decimal" },
              "evidence_hash": { "$ref": "#/$defs/hash" }
            }
          }
        }
      ]
    },
    "externalObservationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "base_evidence_hash", "observer", "audience", "observed_at", "issued_at", "expires_at", "observer_boundary", "bindings", "requested_limits", "birth_controls", "network", "provider_controls", "cost", "observation_hash", "signature"],
      "properties": {
        "schema": { "const": "agoragentic.risk-fork.e2b-external-qualification-observation.v1" },
        "base_evidence_hash": { "$ref": "#/$defs/hash" },
        "observer": { "$ref": "#/$defs/observer" },
        "audience": { "$ref": "#/$defs/observationAudience" },
        "observed_at": { "type": "string", "format": "date-time" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "observer_boundary": { "$ref": "#/$defs/observerBoundary" },
        "bindings": { "$ref": "#/$defs/observationBindings" },
        "requested_limits": { "$ref": "#/$defs/requestedLimits" },
        "birth_controls": { "$ref": "#/$defs/birthControls" },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_instruction_ipv4_egress_denied", "first_instruction_ipv6_egress_denied", "ipv6_provider_denial"],
          "properties": {
            "first_instruction_ipv4_egress_denied": { "type": "boolean" },
            "first_instruction_ipv6_egress_denied": { "type": "boolean" },
            "ipv6_provider_denial": { "$ref": "#/$defs/statusEvidence" }
          }
        },
        "provider_controls": { "$ref": "#/$defs/providerControls" },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "provider_cap", "derived_estimate", "aggregate_console_delta", "actual_sandbox"],
          "properties": {
            "currency": { "const": "USD" },
            "provider_cap": { "$ref": "#/$defs/observedCostLine" },
            "derived_estimate": { "$ref": "#/$defs/observedCostLine" },
            "aggregate_console_delta": { "$ref": "#/$defs/observedCostLine" },
            "actual_sandbox": { "$ref": "#/$defs/actualSandboxCost" }
          }
        },
        "observation_hash": { "$ref": "#/$defs/hash" },
        "signature": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["observer_boundary"],
            "properties": {
              "observer_boundary": {
                "type": "object",
                "required": ["status"],
                "properties": { "status": { "enum": ["failed", "unknown"] } }
              }
            }
          },
          "then": {
            "properties": {
              "birth_controls": {
                "type": "object",
                "properties": {
                  "inherited_environment_absent": { "$ref": "#/$defs/nonVerifiedStatusEvidence" },
                  "inherited_processes_absent": { "$ref": "#/$defs/nonVerifiedStatusEvidence" },
                  "credential_files_absent": { "$ref": "#/$defs/nonVerifiedStatusEvidence" },
                  "wallet_material_absent": { "$ref": "#/$defs/nonVerifiedStatusEvidence" },
                  "persistent_mounts_absent": { "$ref": "#/$defs/nonVerifiedStatusEvidence" },
                  "unauthorized_sockets_absent": { "$ref": "#/$defs/nonVerifiedStatusEvidence" },
                  "fresh_entropy_verified": { "$ref": "#/$defs/nonVerifiedStatusEvidence" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
