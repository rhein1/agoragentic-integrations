{
  "name": "@agoragentic/risk-fork",
  "version": "0.1.0-alpha.1",
  "description": "Provider-neutral fork-before-risk contracts, deterministic controls, and local reference tooling for agent execution.",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "author": {
    "name": "Jeremy Borden",
    "url": "https://agoragentic.com"
  },
  "homepage": "https://github.com/rhein1/agoragentic-integrations/tree/main/risk-fork",
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./canonical": "./src/canonical.mjs",
    "./child-operation": "./src/child-operation.mjs",
    "./contracts": "./src/contracts.mjs",
    "./classifier": "./src/risk-classifier.mjs",
    "./lifecycle": "./src/lifecycle.mjs",
    "./provider": "./src/provider.mjs",
    "./taint-gate": "./src/taint-gate.mjs",
    "./clean-commit": "./src/clean-commit.mjs",
    "./distributed-authority": "./src/distributed-authority.mjs",
    "./controller": "./src/controller.mjs",
    "./interception": "./src/interception.mjs",
    "./host-boundary": "./src/host-boundary.mjs",
    "./mcp-host-adapter": "./src/mcp-host-adapter.mjs",
    "./receipt": "./src/receipt.mjs",
    "./e2b-qualification": "./src/e2b-qualification.mjs",
    "./adapters/local-reference": "./src/adapters/local-reference.mjs",
    "./adapters/e2b": "./src/adapters/e2b.mjs",
    "./adapters/e2b-source-verifier": "./src/adapters/e2b-source-verifier.mjs",
    "./adapters/postgres-authority": "./src/adapters/postgres-authority.mjs",
    "./adapters/postgres-authority-migrator": "./src/adapters/postgres-authority-migrator.mjs",
    "./migrations/*": "./migrations/*",
    "./schema/*": "./schema/*"
  },
  "files": [
    "src/",
    "schema/",
    "migrations/",
    "e2b-template/",
    "ops/",
    "scripts/",
    "examples/",
    "assets/",
    "README.md",
    "GETTING_STARTED.md",
    "MCP_HOST_ADAPTER.md",
    "CITATION.cff",
    "AUTHORS.md",
    "CHANGELOG.md",
    "SECURITY_MODEL.md",
    "POSTGRES_AUTHORITY_RUNBOOK.md",
    "PROVIDER_COMPARISON.md",
    "ADVERSARIAL_REMEDIATION.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:package": "node scripts/verify-package-consumer.mjs",
    "test:postgres": "node --test test/postgres-clean-commit-contract.test.mjs test/postgres-clean-commit-integration.test.mjs test/postgres-distributed-authority-contract.test.mjs test/postgres-distributed-authority.test.mjs test/postgres-authority-hardening-contract.test.mjs test/postgres-authority-hardening.test.mjs",
    "check": "node scripts/check.mjs",
    "self-test": "node examples/local-reference.mjs",
    "benchmark:local": "node scripts/benchmark-local.mjs",
    "e2b:build-template": "node scripts/e2b-build-template.mjs",
    "e2b:live-qualification": "node scripts/e2b-live-qualification.mjs",
    "postgres:migrate": "node scripts/migrate-postgres-authority.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "e2b": "2.39.0"
  },
  "peerDependencies": {
    "e2b": "2.39.0"
  },
  "peerDependenciesMeta": {
    "e2b": {
      "optional": true
    }
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "sandbox",
    "fork",
    "security",
    "transaction-assurance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhein1/agoragentic-integrations.git",
    "directory": "risk-fork"
  },
  "bugs": {
    "url": "https://github.com/rhein1/agoragentic-integrations/issues"
  }
}
