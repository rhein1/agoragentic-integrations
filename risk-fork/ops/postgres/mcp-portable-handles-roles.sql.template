-- Owner-reviewed template for a DEDICATED test/service database only.
-- PUBLIC database revocations affect other users; never apply to a shared DB.
-- Apply after the explicit migration, with schema/tables/functions owned by
-- the separately reviewed non-runtime migrator. No password or role creation.
BEGIN;
REVOKE CONNECT, CREATE, TEMPORARY ON DATABASE __MCP_HANDLE_DATABASE__ FROM PUBLIC;
GRANT CONNECT ON DATABASE __MCP_HANDLE_DATABASE__ TO __MCP_HANDLE_RUNTIME_ROLE__;
REVOKE CREATE, TEMPORARY ON DATABASE __MCP_HANDLE_DATABASE__ FROM __MCP_HANDLE_RUNTIME_ROLE__;
REVOKE ALL ON SCHEMA __MCP_HANDLE_SCHEMA__ FROM PUBLIC;
GRANT USAGE ON SCHEMA __MCP_HANDLE_SCHEMA__ TO __MCP_HANDLE_RUNTIME_ROLE__;
REVOKE CREATE ON SCHEMA __MCP_HANDLE_SCHEMA__ FROM __MCP_HANDLE_RUNTIME_ROLE__;
REVOKE ALL ON ALL TABLES IN SCHEMA __MCP_HANDLE_SCHEMA__ FROM PUBLIC, __MCP_HANDLE_RUNTIME_ROLE__;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA __MCP_HANDLE_SCHEMA__ FROM PUBLIC, __MCP_HANDLE_RUNTIME_ROLE__;
GRANT SELECT ON TABLE __MCP_HANDLE_SCHEMA__.handle_schema_migrations TO __MCP_HANDLE_RUNTIME_ROLE__;
GRANT SELECT, INSERT ON TABLE __MCP_HANDLE_SCHEMA__.handle_namespaces TO __MCP_HANDLE_RUNTIME_ROLE__;
-- Row locking requires a column UPDATE grant; the immutable trigger rejects
-- actual updates, and attestation forbids every other namespace column.
GRANT UPDATE (max_entries) ON TABLE __MCP_HANDLE_SCHEMA__.handle_namespaces TO __MCP_HANDLE_RUNTIME_ROLE__;
GRANT SELECT, INSERT ON TABLE __MCP_HANDLE_SCHEMA__.portable_handles TO __MCP_HANDLE_RUNTIME_ROLE__;
GRANT UPDATE (consumption_count, revoked_at) ON TABLE __MCP_HANDLE_SCHEMA__.portable_handles TO __MCP_HANDLE_RUNTIME_ROLE__;
GRANT SELECT, INSERT ON TABLE __MCP_HANDLE_SCHEMA__.handle_consumptions TO __MCP_HANDLE_RUNTIME_ROLE__;
REVOKE DELETE, TRUNCATE, REFERENCES, TRIGGER ON ALL TABLES IN SCHEMA __MCP_HANDLE_SCHEMA__ FROM __MCP_HANDLE_RUNTIME_ROLE__;
ALTER DEFAULT PRIVILEGES IN SCHEMA __MCP_HANDLE_SCHEMA__ REVOKE ALL ON TABLES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES IN SCHEMA __MCP_HANDLE_SCHEMA__ REVOKE ALL ON FUNCTIONS FROM PUBLIC;
COMMIT;
