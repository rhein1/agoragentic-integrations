-- Database-owner bootstrap for the Risk Fork PostgreSQL authority.
-- Replace every placeholder with a separately provisioned, validated lowercase
-- PostgreSQL identifier. Execute this file as the database owner after creating
-- the two NOINHERIT LOGIN roles and before running migration 001 as the migrator.

BEGIN;

REVOKE CONNECT, CREATE, TEMPORARY ON DATABASE __RISK_FORK_DATABASE__ FROM PUBLIC;
GRANT CONNECT, CREATE ON DATABASE __RISK_FORK_DATABASE__
TO __RISK_FORK_MIGRATOR_ROLE__;
GRANT CONNECT ON DATABASE __RISK_FORK_DATABASE__
TO __RISK_FORK_RUNTIME_ROLE__;
REVOKE CREATE, TEMPORARY ON DATABASE __RISK_FORK_DATABASE__
FROM __RISK_FORK_RUNTIME_ROLE__;

CREATE SCHEMA IF NOT EXISTS __RISK_FORK_SCHEMA__;
REVOKE ALL ON SCHEMA __RISK_FORK_SCHEMA__ FROM PUBLIC;
GRANT USAGE, CREATE ON SCHEMA __RISK_FORK_SCHEMA__
TO __RISK_FORK_MIGRATOR_ROLE__;
GRANT USAGE ON SCHEMA __RISK_FORK_SCHEMA__
TO __RISK_FORK_RUNTIME_ROLE__;
REVOKE CREATE ON SCHEMA __RISK_FORK_SCHEMA__
FROM __RISK_FORK_RUNTIME_ROLE__;

COMMIT;
