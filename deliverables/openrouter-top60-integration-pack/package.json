{
  "name": "@agoragentic/openrouter-top60-integration-pack-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --import tsx --test",
    "test:runtime": "node --import tsx --test test/runtime-contracts.test.mjs",
